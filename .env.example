# Elasticsearch Configuration
ELASTICSEARCH_URL=https://your-elasticsearch-url.com
INDEX_NAME=productos

# External API
PRODUCTOS_API_URL=https://your-products-api.com/api/v1/products

# ML Model
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=E-commerce Traditional Search
VERSION=1.0.0

# Performance
SYNC_TIMEOUT=30
SEARCH_TIMEOUT=5
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=INFO